# ============================================================
# asset-app-back — variables de producción (VPS)
# Copiar como .env en el servidor:  cp .env.production.example .env
# IMPORTANTE: sin comillas en los valores. Docker las pasa literales y Prisma falla (P1012).
# NUNCA se commitea (.env está en .gitignore)
# ============================================================

NODE_ENV=production
PORT=3000

# ------------------------------------------------------------
# BASE DE DATOS — Supabase (la BD no se mueve, sigue donde está)
#
# VERIFICADO el 2026-08-20 desde un contenedor real:
#   :5432 (session pooler / directa) → conecta OK
#   :6543 (transaction pooler)       → acepta TCP pero NUNCA responde
#                                      al handshake → Prisma falla con P1001
# Por eso DATABASE_URL apunta al 5432. En un VPS es lo correcto de todos
# modos: un proceso Node de larga vida no necesita el pooler de
# transacciones (ese existe para entornos serverless).
# Si Supabase repara el 6543 y quieres volver, usa:
#   DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:6543/postgres?pgbouncer=true
#
# SIN COMILLAS en los valores: Docker las pasa literales y Prisma
# devuelve P1012 ("the URL must start with postgresql://").
# El entrypoint las limpia por si acaso, pero no las pongas.
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres?connection_limit=10&pool_timeout=20
DIRECT_URL=postgresql://postgres.TU_PROJECT_REF:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------
# CORS — orígenes del frontend separados por coma
# ------------------------------------------------------------
CORS_ORIGINS=https://asset-app-front.vercel.app,https://asset-app-front-ew98.vercel.app

# ------------------------------------------------------------
# AUTH
# OJO: si JWT_SECRET no se define, el código usa 'superclave' por defecto.
# Ponle un valor propio y largo. Cambiarlo invalida las sesiones activas
# (los usuarios tendrán que volver a iniciar sesión).
# Generar:  openssl rand -hex 32
# ------------------------------------------------------------
JWT_SECRET=CAMBIAME_openssl_rand_hex_32
AUTH_TOKEN_EXPIRES_IN=never
AUTH_IGNORE_TOKEN_EXPIRATION=true

# COOKIE_ENCRYPTION_KEY: dejar TAL COMO ESTÁ HOY en Render.
# Si hoy está vacía, déjala comentada: activarla ahora haría ilegibles
# los tokens ya guardados en la columna person.current_token.
# COOKIE_ENCRYPTION_KEY=

# ------------------------------------------------------------
# EMAIL (SMTP)
# ------------------------------------------------------------
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=
HR_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# ------------------------------------------------------------
# INTEGRACIÓN — hwid-server consulta /integrations/people/by-cedula/:cedula
# para autocompletar datos del responsable en HWIDApp. Tráfico servidor a
# servidor, no navegador (no requiere tocar CORS_ORIGINS).
# Generar: openssl rand -hex 32
# ------------------------------------------------------------
HWID_INTEGRATION_API_KEY=CAMBIAME_openssl_rand_hex_32

# ------------------------------------------------------------
# TLS: NO definir SSL_KEY_PATH / SSL_CERT_PATH.
# El HTTPS lo termina Nginx; la app habla HTTP en el loopback.
# ------------------------------------------------------------

# ------------------------------------------------------------
# Base de datos propia en el VPS (contenedor db de docker-compose)
# El host es "db": el nombre del servicio en la red de compose.
# Genera la contraseña con: openssl rand -hex 24
# ------------------------------------------------------------
POSTGRES_USER=asset
POSTGRES_PASSWORD=
POSTGRES_DB=asset_manager

# Con la base en el VPS, ambas URLs son la misma:
# DATABASE_URL=postgresql://asset:LA_PASSWORD@db:5432/asset_manager?schema=public
# DIRECT_URL=postgresql://asset:LA_PASSWORD@db:5432/asset_manager?schema=public
